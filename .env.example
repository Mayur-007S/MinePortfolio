# Copy this file to .env and fill in your EmailJS details
# NEVER commit your actual .env file to GitHub

# Create an account at https://www.emailjs.com/
# 1. Add "Gmail" as your Email Service to get your Service ID
VITE_EMAILJS_SERVICE_ID=your_service_id_here

# 2. Create an Email Template to get your Template ID
VITE_EMAILJS_TEMPLATE_ID=your_template_id_here

# 3. Get your Public Key from the Account settings
VITE_EMAILJS_PUBLIC_KEY=your_public_key_here

# Security: Toggle inspection/DevTools protection
# Set to 'true' to allow inspect/DevTools, or 'false' (or leave empty) to block it
VITE_ENABLE_INSPECT=false
